APP_ENV=development

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=your_postgres_username
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=resolveai
TEST_POSTGRES_DB=resolveai_test

# Redis from docker-compose (published on 127.0.0.1 only).
REDIS_URL=redis://127.0.0.1:6379/0

HEALTH_CHECK_TIMEOUT_S=2.0

# Gemini LLM (key from aistudio.google.com). Leave the key empty to run without the agent
# (tests use a mocked LLM).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# none | low | medium | high. "none" turns thinking off: fastest replies for voice.
# Thinking tokens count toward LLM_MAX_COMPLETION_TOKENS, so raise both together.
LLM_REASONING_EFFORT=none
LLM_MAX_COMPLETION_TOKENS=400
# Optional: a fixed seed (best effort on hosted models) and a client-side tokens-per-minute
# budget matching your Gemini tier, so concurrent sessions wait instead of hitting 429.
# LLM_SEED=
# LLM_TOKENS_PER_MINUTE=
AGENT_PROMPT_VERSION=v3
AGENT_MAX_ITERATIONS=6
# Verify the customer and look up a named order straight from their message, without a
# model call each (backend/app/agent/prefetch.py). false: the model makes every tool call.
AGENT_PREFETCH=true
AGENT_TURN_TIMEOUT_S=30
SESSION_TTL_S=3600

# Policy documents (docs/policies/). "retrieval": the agent searches them with the
# search_policies tool (run `make ingest-policies` first). "full_text": all of them go into
# the system prompt instead. Needs AGENT_PROMPT_VERSION=v3 or later.
POLICY_CONTEXT_MODE=retrieval
# POLICY_DOCS_DIR=/path/to/docs/policies
# Local embedding model (fastembed, no API key); downloaded once into the cache dir.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDING_CACHE_DIR=~/.cache/resolveai/fastembed
# hybrid (full-text + vector, fused with RRF), vector or text.
RETRIEVAL_SEARCH_MODE=hybrid
RETRIEVAL_TOP_K=3

# Optional: another policy file (defaults to backend/app/policy/policy.yaml).
# POLICY_FILE=/path/to/policy.yaml
